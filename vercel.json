{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://18.205.229.159:8000/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "http://18.205.229.159:8000/v1/:path*"
    },

    { "source": "/downloads/(.*)", "destination": "/downloads/$1" },

    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
